<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_stock_register" model="ir.ui.view">
        <field name="name">res.company.form.petroleum.stock.register</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Petroleum stock register" name="petro_stock_register">
                    <field name="petro_stock_register_mode" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
