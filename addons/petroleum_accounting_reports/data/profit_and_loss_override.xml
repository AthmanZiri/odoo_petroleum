<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Petroleum P&amp;L layout:
        Revenue → Cost of Sales → Gross Profit → Expenses → Net Profit
        Net = Gross − Expenses (= Revenue − Cost of Sales − Expenses)
    -->
    <record id="account_reports.account_financial_report_revenue0" model="account.report.line">
        <field name="name">Revenue</field>
        <field name="hierarchy_level">1</field>
    </record>
    <record id="account_reports.account_financial_report_revenue0_balance" model="account.report.expression">
        <field name="formula" eval="[('account_id.account_type', '=', 'income')]"/>
        <field name="subformula">-sum</field>
    </record>

    <record id="account_reports.account_financial_report_cost_sales0" model="account.report.line">
        <field name="name">Cost of Sales</field>
        <field name="hierarchy_level">1</field>
    </record>
    <record id="account_reports.account_financial_report_cost_sales0_balance" model="account.report.expression">
        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost')]"/>
        <field name="subformula">sum</field>
        <field name="green_on_positive" eval="False"/>
    </record>

    <record id="account_reports.account_financial_report_gross_profit0" model="account.report.line">
        <field name="name">Gross Profit</field>
        <field name="hierarchy_level">0</field>
    </record>
    <record id="account_reports.account_financial_report_gross_profit0_balance" model="account.report.expression">
        <field name="formula">REV.balance - COS.balance</field>
    </record>

    <record id="account_reports.account_financial_report_expense0" model="account.report.line">
        <field name="name">Expenses</field>
        <field name="hierarchy_level">1</field>
    </record>
    <record id="account_reports.account_financial_report_expense0_balance" model="account.report.expression">
        <field name="formula" eval="[('account_id.account_type', 'in', ('expense', 'expense_depreciation', 'expense_other'))]"/>
        <field name="subformula">sum</field>
        <field name="green_on_positive" eval="False"/>
    </record>

    <record id="account_reports.account_financial_report_net_profit0" model="account.report.line">
        <field name="name">Net Profit</field>
        <field name="hierarchy_level">0</field>
    </record>
    <record id="account_reports.account_financial_report_net_profit0_balance" model="account.report.expression">
        <field name="formula">GRP.balance - EXP.balance</field>
    </record>

    <!-- Drop intermediate lines that break Gross − Expenses = Net -->
    <delete model="account.report.line" search="[('report_id', '=', ref('account_reports.profit_and_loss')), ('code', 'in', ['INC', 'OIN', 'OEXP', 'ALLOC', 'NEPAL'])]"/>

    <function model="account.account" name="_petroleum_reclassify_purchase_cost_accounts"/>
</odoo>
