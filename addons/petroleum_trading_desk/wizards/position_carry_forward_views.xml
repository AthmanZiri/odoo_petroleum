<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_position_carry_forward_form" model="ir.ui.view">
        <field name="name">petroleum.daily.position.carry.forward.form</field>
        <field name="model">petroleum.daily.position.carry.forward</field>
        <field name="arch" type="xml">
            <form string="Carry Forward">
                <group>
                    <field name="target_date"/>
                    <field name="source_line_ids" invisible="1"/>
                </group>
                <field name="notice" readonly="1" invisible="not notice" nolabel="1"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0">
                        <field name="position_line_id" column_invisible="1"/>
                        <field name="quantity"/>
                        <field name="qty_remaining"/>
                        <field name="date"/>
                        <field name="product_id" options="{'no_open': True}"/>
                        <field name="supplier_id" options="{'no_open': True}"/>
                        <field name="depot_id" options="{'no_open': True}"/>
                    </list>
                </field>
                <div class="text-muted">
                    Shows lots from the date you selected. Click Quantity to carry
                    and type the litres to roll. Zero skips that lot. Carry Forward
                    To must be after that date; other dates are not filled in.
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Carry Forward" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
