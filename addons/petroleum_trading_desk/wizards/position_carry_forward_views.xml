<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_position_carry_forward_form" model="ir.ui.view">
        <field name="name">petroleum.daily.position.carry.forward.form</field>
        <field name="model">petroleum.daily.position.carry.forward</field>
        <field name="arch" type="xml">
            <form string="Carry Forward">
                <group>
                    <field name="target_date"/>
                    <field name="qty_to_carry" readonly="1"/>
                    <field name="restrict_line_ids" invisible="1"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="position_line_id" column_invisible="1"/>
                        <field name="date" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="supplier_id" readonly="1"/>
                        <field name="depot_id" readonly="1"/>
                        <field name="qty_remaining" readonly="1"/>
                        <field name="quantity" sum="Quantity to carry"/>
                    </list>
                </field>
                <div class="text-muted">
                    Rolls the entered quantity from each listed lot onto this date.
                    Lines already on or after the date stay put.
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Carry Forward" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
