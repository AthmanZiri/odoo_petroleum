<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_journal_repay_form" model="ir.ui.view">
        <field name="name">petroleum.loan.journal.repay.form</field>
        <field name="model">petroleum.loan.journal.repay</field>
        <field name="arch" type="xml">
            <form string="Allocate Journal Repayment">
                <group>
                    <group>
                        <field name="move_id" options="{'no_create': True}"/>
                        <field name="partner_id"/>
                        <field name="loan_issued_id" options="{'no_create': True}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="amount"/>
                    </group>
                </group>
                <field name="allocation_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="loan_issued_id" options="{'no_create': True}"/>
                        <field name="amount_outstanding" readonly="1"/>
                        <field name="amount_allocated"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="alert alert-info" role="alert">
                    The entry must already credit Loans Issued (principal).
                    Allocation is oldest loan first. Interest credits do not reduce principal.
                    This does not post a second entry.
                </div>
                <field name="currency_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Allocate"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_loan_journal_repay" model="ir.actions.act_window">
        <field name="name">Allocate Journal Repayment</field>
        <field name="res_model">petroleum.loan.journal.repay</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
