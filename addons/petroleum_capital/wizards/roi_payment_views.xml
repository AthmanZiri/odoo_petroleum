<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_roi_payment_form" model="ir.ui.view">
        <field name="name">petroleum.roi.payment.form</field>
        <field name="model">petroleum.roi.payment</field>
        <field name="arch" type="xml">
            <form string="Pay Investor ROI">
                <group>
                    <group>
                        <field name="investor_capital_id" options="{'no_create': True}"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="payment_date"/>
                        <field name="amount"/>
                        <field name="expense_account_id" options="{'no_create': True}"/>
                        <field name="bank_journal_id" options="{'no_create': True}"/>
                        <field name="memo" placeholder="e.g. July 2026 ROI — Zaynu"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert">
                    This posts <strong>Dr ROI Expense / Cr Bank</strong> only.
                    Invested equity capital is not reduced.
                </div>
                <field name="currency_id" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Pay ROI"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_roi_payment" model="ir.actions.act_window">
        <field name="name">Pay Investor ROI</field>
        <field name="res_model">petroleum.roi.payment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
