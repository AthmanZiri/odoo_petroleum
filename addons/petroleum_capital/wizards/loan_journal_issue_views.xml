<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_journal_issue_form" model="ir.ui.view">
        <field name="name">petroleum.loan.journal.issue.form</field>
        <field name="model">petroleum.loan.journal.issue</field>
        <field name="arch" type="xml">
            <form string="Register Loan Issued">
                <group>
                    <group>
                        <field name="move_id" options="{'no_create': True}"/>
                        <field name="loan_issued_id" options="{'no_create': True}"/>
                        <field name="partner_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="asset_account_id" options="{'no_create': True}"/>
                        <field name="note" placeholder="Optional note"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    The journal entry must already be posted and balanced:
                    <strong>Dr Loans Issued / Cr Bank</strong> (or Opening Balance Equity).
                    This does not post a second entry.
                </div>
                <field name="currency_id" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Register Loan"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_loan_journal_issue" model="ir.actions.act_window">
        <field name="name">Register Loan from Journal</field>
        <field name="res_model">petroleum.loan.journal.issue</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
