<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_petroleum_investor_capital" model="ir.sequence">
        <field name="name">Investor Capital</field>
        <field name="code">petroleum.investor.capital</field>
        <field name="prefix">INV-CAP/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_petroleum_loan_issued" model="ir.sequence">
        <field name="name">Loan Issued</field>
        <field name="code">petroleum.loan.issued</field>
        <field name="prefix">LOAN/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
