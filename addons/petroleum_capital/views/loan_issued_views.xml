<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_issued_tree" model="ir.ui.view">
        <field name="name">petroleum.loan.issued.list</field>
        <field name="model">petroleum.loan.issued</field>
        <field name="arch" type="xml">
            <list string="Loans Issued">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="amount" sum="Total Loans"/>
                <field name="amount_repaid" sum="Total Repaid" optional="show"/>
                <field name="amount_outstanding" sum="Outstanding" optional="show"/>
                <field name="state"
                         decoration-info="state == 'draft'"
                         decoration-success="state == 'posted'"
                         widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_loan_issued_form" model="ir.ui.view">
        <field name="name">petroleum.loan.issued.form</field>
        <field name="model">petroleum.loan.issued</field>
        <field name="arch" type="xml">
            <form string="Loan Issued">
                <header>
                    <button name="action_post_opening" type="object"
                            string="Post Opening"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_receive_repayment" type="object"
                            string="Receive Repayment"
                            class="btn-primary"
                            invisible="state != 'posted' or amount_outstanding &lt;= 0"/>
                    <button name="action_open_opening_move" type="object"
                            string="Opening Entry"
                            invisible="not opening_move_id"/>
                    <field name="state" widget="statusbar"
                             statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_repayment_moves" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not repayment_count">
                            <field name="repayment_count" widget="statinfo" string="Repayments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Borrower">
                            <field name="partner_id" readonly="state == 'posted'"/>
                            <field name="date" readonly="state == 'posted'"/>
                            <field name="amount" readonly="state == 'posted'"/>
                            <field name="amount_repaid" readonly="1"/>
                            <field name="amount_outstanding" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                      readonly="state == 'posted'"/>
                        </group>
                        <group string="Accounts">
                            <field name="asset_account_id" readonly="state == 'posted'"
                                      options="{'no_create': True}"/>
                            <field name="bank_journal_id" readonly="state == 'posted'"
                                      options="{'no_create': True}"/>
                            <field name="capital_journal_id" readonly="1"/>
                            <field name="opening_move_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Notes…"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Opening posts Loans Issued under Current Assets via the
                        Capital &amp; Loans journal (not Miscellaneous Operations).
                        Repayment posts Dr Bank / Cr Loans Issued through the selected
                        bank or cash journal. It does not appear in P&amp;L Expenses.
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="repayment_move_ids" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_loan_issued" model="ir.actions.act_window">
        <field name="name">Loans Issued</field>
        <field name="res_model">petroleum.loan.issued</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record loans issued openings (e.g. Muhidin KES 9,676,340.17).
            </p>
            <p>
                After posting, receive principal (and optional interest) with Receive Repayment.
            </p>
        </field>
    </record>
</odoo>
